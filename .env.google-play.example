
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
BILLING_DATABASE_PATH=/data/billing.sqlite3
# CPU-only worker threads; ignored when CUDA is available.
WORKER_THREADS=auto
# VRAM reserved for the transcription model loaded on each GPU.
WORKER_MODEL_MEMORY_GIB=3.0
# Approximate free VRAM budget reserved for each GPU request.
WORKER_MEMORY_PER_JOB_GIB=0.65
# Maximum number of requests combined into one GPU inference batch.
WORKER_BATCH_SIZE=6
# Maximum time to wait for more requests before running a partial batch.
WORKER_BATCH_TIMEOUT_SECONDS=2
WORKER_MAX_CONCURRENCY=auto
CLEANUP_INTERVAL_SECONDS=86400 # 24 hours

MAX_VIDEO_LENGTH_MINUTES=120

# This file contains configuration only. Never commit the Google service-account JSON.

BILLING_PROVIDER=google_play

# Public OAuth client IDs used to validate Google ID tokens. This is preferred
# in containers because it does not require reading the OAuth JSON file.
GOOGLE_OAUTH_CLIENT_IDS=["123456789-example.apps.googleusercontent.com"]

# JSON object: exact Google Play one-time product ID -> transcription minutes
# Example: buying transcription_60 credits 60 minutes to the user.
BILLING_PRODUCTS={"transcription_25":25,"transcription_60":60,"transcription_300":300}

# Android application ID shown in Google Play Console.
GOOGLE_PLAY_PACKAGE_NAME=com.lumenchord.pianoweave

# Filename of the Google service-account JSON placed in the local ./secrets folder.
# The service account needs Android Publisher API access to this application.
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=google-play-service-account.json

# Free minutes are topped up to this amount at most once per period.
FREE_MINUTES=10
FREE_MINUTES_PERIOD=30d

# Docker Compose automatically mounts the local ./secrets directory at /run/secrets
# for the API and worker. Put the service-account JSON at:
#   ./secrets/google-play-service-account.json
# The product IDs in BILLING_PRODUCTS must exist in Google Play Console. On startup,
# the server logs warnings for missing or unconfigured Google Play products; only
# products confirmed by the startup sync are advertised by /api/server-info.
