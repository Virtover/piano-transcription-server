FROM python:3.12-slim

WORKDIR /app

# The build's own tools: apt's mirror lists, and fetch.py and pip_install.py,
# which take each download from the next source when one fails.
COPY build/apt /build/apt
COPY build/apt-mirrors.sh build/apt_install.sh build/fetch.py build/pip_install.py /build/

# yt-dlp runs deno for YouTube. A fixed version, checked against its
# published checksum: from GitHub, else Deno's own server, which builds each
# release again and gives it another checksum. To update: change the version
# and both checksums, each from its source's .sha256sum file next to the zip.
ARG DENO_VERSION=2.9.8
ARG DENO_SHA256=e890975bc2549807bbcc0b584ffafda72cc7c93349dd99c80483dd784f6c4609
ARG DENO_DL_SHA256=a39762429792913fe762ef0b59c9cba41dbd38195984da99221a193b13d97b40

RUN sh /build/apt-mirrors.sh 	&& apt-get update 	&& apt-get install -y --no-install-recommends 		ca-certificates 		ffmpeg 		postgresql-client 		unzip 	&& python /build/fetch.py --sha256 "$DENO_SHA256" --sha256 "$DENO_DL_SHA256" --out /tmp/deno.zip 		"https://github.com/denoland/deno/releases/download/v${DENO_VERSION}/deno-x86_64-unknown-linux-gnu.zip" 		"https://dl.deno.land/release/v${DENO_VERSION}/deno-x86_64-unknown-linux-gnu.zip" 	&& unzip -p /tmp/deno.zip deno > /usr/local/bin/deno 	&& chmod +x /usr/local/bin/deno 	&& rm -f /tmp/deno.zip 	&& rm -rf /var/lib/apt/lists/*

COPY requirements.api.txt .

RUN python /build/pip_install.py --no-cache-dir -r requirements.api.txt

# The services run as this user, not root. New volumes mounted at /data and
# /billing take the ownership below; see "Running as a non-root user" in
# docs/setup.md for volumes created by earlier versions.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin app \
	&& mkdir -p /data /billing \
	&& chown app:app /data /billing

COPY app ./app

USER app

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
