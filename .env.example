# Piano Transcription Server configuration.
# Copy to .env and change what you need. Every setting is described in
# docs/configuration.md. Durations use s, m, h, d, or w, for example 30s, 10m, 7d.
# Secrets never go here: put them as files in ./secrets (see docs/configuration.md).
# Check the result with: docker compose run --rm api python -m app.config check
# To require a password on a private server, put it in ./secrets/server_password
# (see "Password protection" in docs/setup.md).

# --- Limits ---------------------------------------------------------------

# Maximum video or uploaded file length in minutes, or unlimited.
MAX_VIDEO_LENGTH_MINUTES=120
# Maximum size of an uploaded audio or video file in MB, or unlimited.
MAX_UPLOAD_SIZE_MB=200
# Transcriptions in progress at once, in total and per signed-in user.
# Set either value to unlimited to disable that limit.
MAX_ACTIVE_JOBS=50
MAX_ACTIVE_JOBS_PER_USER=5
# Network address the API port is published on: 0.0.0.0 for every interface,
# 127.0.0.1 when an HTTPS proxy on this machine forwards to the API.
API_BIND_ADDRESS=127.0.0.1
# How long users can retrieve a finished transcription and its MIDI file.
RESULT_RETENTION=1h
# How often the files of expired jobs are deleted from disk.
CLEANUP_INTERVAL=10m

# Downloads from one video site at once, or unlimited.
VIDEO_SITE_MAX_DOWNLOADS=2

# --- HTTPS through a Cloudflare Tunnel --------------------------------------

# Starts the cloudflared service. Put the tunnel token in
# ./secrets/cloudflare/tunnel_token first (see docs/cloudflare-tunnel.md).
# COMPOSE_PROFILES=cloudflare
# The tunnel's public hostname, used only by check --online.
# CLOUDFLARE_TUNNEL_HOSTNAME=piano.example.com

# --- Worker ---------------------------------------------------------------

# Ignore available GPUs and run local transcription on CPU.
# WORKER_ENFORCE_CPU=false
# System RAM reserved by WORKER_BATCH_SIZE=auto for the CPU model.
# WORKER_CPU_MODEL_MEMORY_GIB=2.0
# System RAM estimated for each additional CPU transcription in an auto batch.
# WORKER_CPU_MEMORY_PER_JOB_GIB=2.0
# CPU threads for PyTorch and ffmpeg: auto (physical cores minus two) or a number.
WORKER_THREADS=auto
# VRAM reserved on each GPU for the model and GPU libraries.
WORKER_MODEL_MEMORY_GIB=1.0
# VRAM budget for each concurrent GPU job.
WORKER_MEMORY_PER_JOB_GIB=1.1
# Maximum jobs combined into one model batch: auto (each GPU's job capacity,
# CPU/RAM dependent in CPU mode) or a number.
WORKER_BATCH_SIZE=auto
# Maximum wait for more jobs before running a partial batch.
WORKER_BATCH_TIMEOUT=2s
# Optional cap on concurrent GPU jobs: auto or a number.
WORKER_MAX_CONCURRENCY=auto

# --- Billing (Google Play) ------------------------------------------------
# Production billing uses PostgreSQL from Compose. Create
# ./secrets/postgres_password before starting the stack. For a non-Compose
# deployment set BILLING_DATABASE_URL or put the complete URL in
# ./secrets/billing_database_url.
# Uncomment to sell transcription minutes through Google Play. Also put the
# service-account JSON at ./secrets/google_play_service_account.json.
# See docs/google-play-billing.md.

# BILLING_PROVIDER=google_play
# Public OAuth client IDs used to validate Google access tokens.
# GOOGLE_OAUTH_CLIENT_IDS=["123456789-example.apps.googleusercontent.com"]
# Android application ID shown in Google Play Console.
# GOOGLE_PLAY_PACKAGE_NAME=com.example.pianoweave
# Google Play one-time product ID -> transcription minutes.
# BILLING_PRODUCTS={"transcription_25":25,"transcription_60":60,"transcription_300":300}
# Free minutes are topped up to this amount at most once per period.
# FREE_MINUTES=10
# FREE_MINUTES_PERIOD=30d
# How often the billing database is backed up, and which backups are kept by age:
# every one, then the first of each hour, day, week, and month. 0s turns a step off.
# BILLING_BACKUP_INTERVAL=15m
# BILLING_BACKUP_KEEP_ALL=1d
# BILLING_BACKUP_KEEP_HOURLY=2d
# BILLING_BACKUP_KEEP_DAILY=14d
# BILLING_BACKUP_KEEP_WEEKLY=8w
# BILLING_BACKUP_KEEP_MONTHLY=0s
# Optional upper limit on the age of any backup.
# BILLING_BACKUP_RETENTION=30d
# BILLING_JOB_DIAGNOSTICS_RETENTION=30d
# How often refunded purchases are read from Google Play and their minutes taken back.
# GOOGLE_PLAY_VOIDED_PURCHASES_INTERVAL=1h

# --- Off-site backups (optional) -----------------------------------------

# Encrypted copies of the billing backups in S3-compatible storage, in a
# bucket of their own. Setting the bucket turns them on. The secret files
# secrets/offsite_backup_access_key and secrets/offsite_backup_secret_key are
# needed too. See "Off-site copies" in docs/configuration.md.
# OFFSITE_BACKUP_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
# OFFSITE_BACKUP_BUCKET=piano-billing-backups
# The age public key printed by: python -m app.backups keygen
# OFFSITE_BACKUP_RECIPIENT=age1...

# --- Outsourcing (RunPod) ------------------------------------------------
# Uncomment to run jobs on RunPod Serverless when the local GPU is overloaded,
# then run: docker compose up -d. This setting is the only switch: the remote
# worker is always part of the stack and idles while outsourcing is off.
# Also put runpod_api_key, outsource_storage_access_key, and
# outsource_storage_secret_key in ./secrets, and optionally runpod_read_api_key
# for OUTSOURCE_MAX_CONCURRENCY=auto. See docs/runpod.md.

# OUTSOURCE_PROVIDER=runpod
# RUNPOD_ENDPOINT_ID=
# Routing: local_first, remote_first_overflow, or remote_first_fallback.
# OUTSOURCE_ROUTING=local_first
# Only for local_first: outsource when estimated local wait is longer than this.
# OUTSOURCE_LOCAL_FIRST_MAX_WAIT=30s
# Maximum remote jobs at once, or auto (RunPod max workers x requests per worker).
# OUTSOURCE_MAX_CONCURRENCY=4
# OUTSOURCE_TIMEOUT=15m
# On remote failure, put the job back on the local queue instead of failing it.
# OUTSOURCE_FALLBACK_LOCAL=true
# S3-compatible storage for handing audio to RunPod (Cloudflare R2, MinIO, AWS S3).
# OUTSOURCE_STORAGE_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
# OUTSOURCE_STORAGE_BUCKET=
# OUTSOURCE_STORAGE_REGION=auto
