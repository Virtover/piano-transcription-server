REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
BILLING_DATABASE_PATH=/data/billing.sqlite3
WORKER_PROCESSES=auto
WORKER_THREADS=auto
# CPU-only automatic concurrency. Increase after monitoring RAM usage.
WORKER_CPU_CONCURRENCY=1
# Approximate free VRAM budget reserved for each concurrent transcription job.
WORKER_MEMORY_PER_JOB_GIB=3
# Optional safety limit. Leave as auto to use all detected capacity.
WORKER_MAX_CONCURRENCY=auto
CLEANUP_INTERVAL_SECONDS=600

# Billing: none or google_play
BILLING_PROVIDER=none
# Leave empty for no maximum.
MAX_VIDEO_LENGTH_MINUTES=