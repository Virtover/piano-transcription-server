# Piano Transcription Server: what Docker Compose itself reads.
#
# Only for the Docker Compose stack. The server's settings, the same on every
# deployment, are in server.env (from server.env.example); scripts/server.py
# and scripts/setup.py move a line that is in the wrong file.
#
# A basic server needs nothing here: python scripts/server.py start copies
# this file to .env and runs.

# --- Services ------------------------------------------------------------------
# Optional services to start besides the stack: cloudflare for HTTPS through a
# Cloudflare Tunnel (docs/cloudflare-tunnel.md), admin for the admin web page
# (docs/administration.md), which needs both: COMPOSE_PROFILES=cloudflare,admin
# COMPOSE_PROFILES=cloudflare
# The admin web page's access: read-only, or read-write to also cancel jobs,
# change balances, and limits. Compose signs its service in with the roles of
# this mode; its other settings are in server.env.
# ADMIN_WEB_MODE=read-only

# --- Network --------------------------------------------------------------------
# The network address the API port is published on: 127.0.0.1 when an HTTPS
# proxy or tunnel on this machine forwards to the API, 0.0.0.0 for every interface.
API_BIND_ADDRESS=127.0.0.1

# --- Database folder ---------------------------------------------------------------
# Where PostgreSQL keeps the live database: ./billing-data/postgres, a folder on
# this machine, or postgres_data, a Docker volume. On Windows and macOS a Docker
# volume is faster and syncs to disk more reliably. Changing it does not move
# the data: see "Moving the billing database" in docs/configuration.md.
# POSTGRES_DATA_LOCATION=./billing-data/postgres

# --- Worker image ------------------------------------------------------------------
# legacy builds the worker for older NVIDIA GPUs such as the GTX 1050 Ti
# (GTX 10 series). Rebuild after changing it.
# WORKER_GPU_BUILD=current
