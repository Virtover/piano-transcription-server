REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
BILLING_DATABASE_PATH=/billing/billing.sqlite3
# How often the billing database is backed up, and how long backups are kept.
# Use s, m, h, d, or w, for example 30m, 1h, 7d.
BILLING_BACKUP_INTERVAL=1h
BILLING_BACKUP_RETENTION=30d
# CPU-only worker threads; ignored when CUDA is available.
WORKER_THREADS=auto
# VRAM reserved for the transcription model loaded on each GPU.
WORKER_MODEL_MEMORY_GIB=3.0
# Approximate free VRAM budget reserved for each GPU request.
WORKER_MEMORY_PER_JOB_GIB=0.65
# Maximum number of requests combined into one GPU inference batch.
WORKER_BATCH_SIZE=6
# Maximum time to wait for more requests before running a partial batch.
WORKER_BATCH_TIMEOUT_SECONDS=2
# Optional GPU request concurrency cap. Leave as auto to use all detected capacity.
WORKER_MAX_CONCURRENCY=auto
CLEANUP_INTERVAL_SECONDS=600

# Billing: none or google_play
BILLING_PROVIDER=none
# Leave empty for no maximum.
MAX_VIDEO_LENGTH_MINUTES=