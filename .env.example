# Piano Transcription Server configuration.
# Copy to .env and change what you need. Every setting is described in
# docs/configuration.md. Durations use s, m, h, d, or w, for example 30s, 10m, 7d.
# Secrets never go here: put them as files in ./secrets (see docs/configuration.md).
# Check the result with: docker compose run --rm api python -m app.config check

# --- Limits ---------------------------------------------------------------

# Maximum video or uploaded file length. Leave empty for no maximum.
MAX_VIDEO_LENGTH_MINUTES=60
# Maximum size of an uploaded audio or video file.
MAX_UPLOAD_SIZE_MB=200
# How often expired job files are deleted.
CLEANUP_INTERVAL=10m

# --- Worker ---------------------------------------------------------------

# CPU threads for PyTorch and ffmpeg: auto (physical cores minus two) or a number.
WORKER_THREADS=auto
# VRAM reserved on each GPU for the model and GPU libraries.
WORKER_MODEL_MEMORY_GIB=1.0
# VRAM budget for each concurrent GPU job.
WORKER_MEMORY_PER_JOB_GIB=1.1
# Maximum jobs combined into one model batch.
WORKER_BATCH_SIZE=6
# Maximum wait for more jobs before running a partial batch.
WORKER_BATCH_TIMEOUT=2s
# Optional cap on concurrent GPU jobs: auto or a number.
WORKER_MAX_CONCURRENCY=auto

# --- Billing (Google Play) ------------------------------------------------
# Uncomment to sell transcription minutes through Google Play. Also put the
# service-account JSON at ./secrets/google_play_service_account.json.
# See docs/google-play-billing.md.

# BILLING_PROVIDER=google_play
# Public OAuth client IDs used to validate Google ID tokens.
# GOOGLE_OAUTH_CLIENT_IDS=["123456789-example.apps.googleusercontent.com"]
# Android application ID shown in Google Play Console.
# GOOGLE_PLAY_PACKAGE_NAME=com.example.pianoweave
# Google Play one-time product ID -> transcription minutes.
# BILLING_PRODUCTS={"transcription_25":25,"transcription_60":60,"transcription_300":300}
# Free minutes are topped up to this amount at most once per period.
# FREE_MINUTES=10
# FREE_MINUTES_PERIOD=30d
# How often the billing database is backed up, and how long backups are kept.
# BILLING_BACKUP_INTERVAL=1h
# BILLING_BACKUP_RETENTION=30d

# --- Outsourcing ----------------------------------------------------------
# Remote inference is not available yet.
