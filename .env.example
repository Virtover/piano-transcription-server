REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
BILLING_DATABASE_PATH=/data/billing.sqlite3
WORKER_PROCESSES=auto
WORKER_THREADS=auto
# Optional safety limit. Leave as auto to use all detected capacity.
WORKER_MAX_CONCURRENCY=auto
CLEANUP_INTERVAL_SECONDS=600

# Billing: none or google_play
BILLING_PROVIDER=none
# Leave empty for no maximum.
MAX_VIDEO_LENGTH_MINUTES=