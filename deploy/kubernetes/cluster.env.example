# The real cluster's own choices, which the server's settings in server.env
# leave out: where the images go, which nodes the GPU workers run on, and
# how far KEDA scales them. scripts/kube.py copies this file to cluster.env
# on the first up, which git ignores, and on every up, update, start, and
# restart writes the component in ./cluster from it. See "Cluster choices"
# in docs/kubernetes.md.

# Where the images are pushed, and the cluster pulls them from, such as
# docker.io/<user> or ghcr.io/<user>. Asked for, and written here, when empty.
KUBE_REGISTRY=

# The label of the nodes with GPUs, as name=value, which the GPU workers are
# kept to. Empty: any node that offers nvidia.com/gpu.
#KUBE_GPU_NODE_LABEL=nvidia.com/gpu.present=true

# The key of the taint that keeps other pods off the GPU nodes, which the GPU
# workers tolerate. Empty: the GPU nodes have no taint.
#KUBE_GPU_NODE_TAINT=nvidia.com/gpu

# The fewest and most GPU workers KEDA runs, each with one GPU: the most is
# what you are willing to pay for, or the GPUs the cluster has.
#KUBE_MIN_WORKERS=1
#KUBE_MAX_WORKERS=4

# One worker more while the oldest job has waited longer than this.
#KUBE_MAX_WAIT=60s

# The namespace KEDA runs in, which alone may read /metrics besides the tunnel.
#KUBE_KEDA_NAMESPACE=keda

# The admin web page behind Cloudflare Access: disabled, read-only, or
# read-write. It sets ADMIN_WEB_MODE in settings.env, and needs the Secret
# piano-admin-web; see "The admin web page" in docs/kubernetes.md.
#KUBE_ADMIN_WEB_MODE=disabled
