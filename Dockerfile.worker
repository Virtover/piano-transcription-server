# GPU_BUILD=legacy (WORKER_GPU_BUILD in .env, or --legacy-gpu of
# scripts/server.py) builds for older NVIDIA GPUs such as the GTX 10 series:
# PyTorch's default CUDA 13 build no longer includes them. The base image only
# sets the driver the container requires; torch brings its own CUDA libraries.
ARG GPU_BUILD=current

# dettato.cpp for ensemble jobs on the CPU (app/transcription/ensemble/cpu.py):
# dettato_cpu/server.cpp, built twice, for CPUs with AVX2 and FMA and for any
# x86-64 CPU, each linked statically, so it runs on any glibc.
# Its source and ggml's are release tarballs checked against their checksums
# (a tarball GitHub changed would fail here, not build something else), and
# its weights a GGUF file at a fixed revision.
FROM ubuntu:24.04 AS dettato-cpp
COPY build /build
RUN sh /build/apt-mirrors.sh \
    && apt-get update \
    && sh /build/apt_install.sh cmake g++ make python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ARG DETTATO_CPP_COMMIT=19d5dc209e66809ca6059f952864db3e775cef2d
ARG DETTATO_CPP_SHA256=da52338946ce58a1912314e7948abd919d48f66626c524e706b2e7e7dba08634
ARG GGML_COMMIT=417a024b4fb6bc3116d41af7c067166a039bdf12
ARG GGML_SHA256=eb2fb2d60331e78de996f4fd3f9cee955cfcab2546b7ad64100444730f39ede7
ARG DETTATO_GGUF_REVISION=73f622a5173c8c9112d7cf2081a0402d73746fc7
ARG DETTATO_GGUF_SHA256=73f08bfcad22c401c1e584229f2b49cb8097a9b539cc81fd29dca573d7585480
RUN mkdir -p /src/dettato.cpp /src/ggml /opt/dettato-cpp/bin \
    && python3 /build/fetch.py --sha256 "$DETTATO_CPP_SHA256" --out /tmp/dettato-cpp.tar.gz \
        "https://github.com/hidude562/dettato.cpp/archive/${DETTATO_CPP_COMMIT}.tar.gz" \
    && python3 /build/fetch.py --sha256 "$GGML_SHA256" --out /tmp/ggml.tar.gz \
        "https://github.com/ggml-org/ggml/archive/${GGML_COMMIT}.tar.gz" \
    && tar -xzf /tmp/dettato-cpp.tar.gz -C /src/dettato.cpp --strip-components=1 \
    && tar -xzf /tmp/ggml.tar.gz -C /src/ggml --strip-components=1 \
    && rm /tmp/*.tar.gz \
    && python3 /build/fetch.py --sha256 "$DETTATO_GGUF_SHA256" --out /opt/dettato-cpp/dettato-f16.gguf \
        "https://huggingface.co/kobimusic/dettato-gguf/resolve/${DETTATO_GGUF_REVISION}/dettato-f16.gguf"
COPY dettato_cpu /src/dettato_cpu
RUN set -e; for variant in avx2 generic; do \
        if [ "$variant" = avx2 ]; then isa=ON; else isa=OFF; fi; \
        cmake -S /src/dettato_cpu -B /tmp/build-$variant -DCMAKE_BUILD_TYPE=Release \
            -DDETTATO_CPP_DIR=/src/dettato.cpp -DFETCHCONTENT_SOURCE_DIR_GGML=/src/ggml \
            -DGGML_NATIVE=OFF -DGGML_AVX=$isa -DGGML_AVX2=$isa -DGGML_FMA=$isa -DGGML_F16C=$isa \
            -DGGML_AVX512=OFF -DGGML_BMI2=$isa > /tmp/cmake-$variant.log; \
        cmake --build /tmp/build-$variant --parallel "$(nproc)" --target dettato_server > /tmp/make-$variant.log \
            || { tail -50 /tmp/make-$variant.log; exit 1; }; \
        cp /tmp/build-$variant/dettato_server /opt/dettato-cpp/bin/dettato_server-$variant; \
        rm -rf /tmp/build-$variant; \
    done \
    && /opt/dettato-cpp/bin/dettato_server-generic 2>&1 | grep -q usage

# Ubuntu 24.04 for its Python 3.12: yt-dlp, which runs on untrusted media,
# drops each Python version once it no longer gets security fixes (3.10's
# ended in October 2026), and an old yt-dlp stops working.
FROM nvidia/cuda:12.8.1-base-ubuntu24.04 AS base-current
FROM nvidia/cuda:12.6.3-base-ubuntu24.04 AS base-legacy
FROM base-${GPU_BUILD}

ARG GPU_BUILD
# PyTorch's CUDA 12.6 build, the newest that still includes Pascal. Its sm_60
# kernels also run on sm_61 cards such as the GTX 1050 Ti.
ARG LEGACY_TORCH_BUILD=cu126

WORKDIR /app

# The build's own tools: apt's mirror lists, and fetch.py and pip_install.py,
# which take each download from the next source when one fails.
COPY build /build

RUN sh /build/apt-mirrors.sh \
    && apt-get update \
    && sh /build/apt_install.sh \
        python3 \
        python3-dev \
        python3-venv \
        ffmpeg \
        build-essential \
        postgresql-client \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# yt-dlp runs deno for YouTube. A fixed version, checked against its
# published checksum: from GitHub, else Deno's own server, which builds each
# release again and gives it another checksum. To update: change the version
# and both checksums, each from its source's .sha256sum file next to the zip.
ARG DENO_VERSION=2.9.8
ARG DENO_SHA256=e890975bc2549807bbcc0b584ffafda72cc7c93349dd99c80483dd784f6c4609
ARG DENO_DL_SHA256=a39762429792913fe762ef0b59c9cba41dbd38195984da99221a193b13d97b40
RUN python3 /build/fetch.py --sha256 "$DENO_SHA256" --sha256 "$DENO_DL_SHA256" --out /tmp/deno.zip \
        "https://github.com/denoland/deno/releases/download/v${DENO_VERSION}/deno-x86_64-unknown-linux-gnu.zip" \
        "https://dl.deno.land/release/v${DENO_VERSION}/deno-x86_64-unknown-linux-gnu.zip" \
    && unzip -p /tmp/deno.zip deno > /usr/local/bin/deno \
    && chmod +x /usr/local/bin/deno \
    && rm -f /tmp/deno.zip

COPY requirements.worker.txt .

# Python packages go in a virtual environment: Ubuntu 24.04's Python refuses
# pip installs into its own (PEP 668). First on PATH, so python3, python,
# pip, and yt-dlp are the environment's for every command and user.
ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH

# For legacy, torch and torchaudio come from PyTorch's index at the versions
# pinned in requirements.worker.txt; 2.14.1+cu126 satisfies torch==2.14.1.
# setuptools at its pin in requirements.worker.txt, for pkg_resources, which
# finds transkun's weights; a new venv does not include it. The last lines
# check both, and print the versions yt-dlp runs with.
RUN /usr/bin/python3 -m venv "$VIRTUAL_ENV" \
    && python3 /build/pip_install.py --upgrade pip wheel $(grep -E '^setuptools==' requirements.worker.txt) \
    && if [ "$GPU_BUILD" = legacy ]; then \
        python3 /build/pip_install.py --torch "$LEGACY_TORCH_BUILD" --no-cache-dir \
            $(grep -E '^(torch|torchaudio)==' requirements.worker.txt) \
        && python3 -c "import torch; flags = torch._C._cuda_getArchFlags(); assert {'sm_60', 'sm_61'} & set(flags.split()), f'torch {torch.__version__} lacks Pascal GPUs: {flags}'"; \
    fi \
    && python3 /build/pip_install.py --no-cache-dir -r requirements.worker.txt \
    && python3 -c "import pkg_resources, sys; assert sys.version_info >= (3, 12), sys.version; pkg_resources.resource_filename('transkun', 'pretrained/2.0.pt')" \
    && echo "$(python3 --version), yt-dlp $(yt-dlp --version), $(deno --version | head -n 1)"

# Beat This! beat tracker weights for the MIDI tempo map
# (app/transcription/tempo.py), checked against their checksum and loaded once.
# From the authors' server (CPJKU, Austria), else a copy on Hugging Face at a
# fixed revision, else the Internet Archive's copy of the authors' file. Only
# a file with this checksum is kept, so a copy can be no other file.
ARG BEAT_THIS_CHECKPOINT_URL=https://cloud.cp.jku.at/public.php/dav/files/7ik4RrBKTS273gp/final0.ckpt
ARG BEAT_THIS_CHECKPOINT_MIRROR=https://huggingface.co/rtikw/localmusic-assets/resolve/a44f51ed621bc9895c15f8b46194cf16d7b22b66/analysis/beat_this-final0.ckpt
ARG BEAT_THIS_CHECKPOINT_ARCHIVE=https://web.archive.org/web/20250720021822id_/https://cloud.cp.jku.at/public.php/dav/files/7ik4RrBKTS273gp/final0.ckpt
ARG BEAT_THIS_CHECKPOINT_SHA256=8c328b45f59d8dd3dff219253ff6a8d6482be57d0133a29140e2febbf8eb8331
RUN mkdir -p /opt/beat-this \
    && python3 /build/fetch.py --sha256 "$BEAT_THIS_CHECKPOINT_SHA256" --out /opt/beat-this/final0.ckpt \
        "$BEAT_THIS_CHECKPOINT_URL" "$BEAT_THIS_CHECKPOINT_MIRROR" "$BEAT_THIS_CHECKPOINT_ARCHIVE" \
    && python3 -c "from beat_this.inference import load_model; load_model('/opt/beat-this/final0.ckpt')"

# dettato's weights for ensemble jobs (app/transcription/arrangement.py), each
# file checked against its checksum (build/dettato-weights.txt); safetensors
# hold tensors only, never code. dettato.cpp and its weights for the CPU.
RUN sh /build/fetch_dettato.sh /opt/dettato
COPY --from=dettato-cpp /opt/dettato-cpp /opt/dettato-cpp
# Lets PyTorch's GPU memory pool grow and shrink in place: the models' steps
# need blocks of many sizes, and without it about 0.2-0.6 GiB more VRAM is
# reserved than used (measured on an ensemble job).
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# The worker runs untrusted media through yt-dlp and ffmpeg, so not as root.
# New volumes mounted at /data and /billing take the ownership below; see
# "Running as a non-root user" in docs/setup.md for older volumes.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /data /billing \
    && chown app:app /data /billing

COPY app ./app

USER app

CMD ["python3", "-m", "app.worker.launcher"]
