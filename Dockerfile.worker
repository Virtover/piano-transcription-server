# GPU_BUILD=legacy (WORKER_GPU_BUILD in .env, or --legacy-gpu of
# scripts/server.py) builds for older NVIDIA GPUs such as the GTX 10 series:
# PyTorch's default CUDA 13 build no longer includes them. The base image only
# sets the driver the container requires; torch brings its own CUDA libraries.
ARG GPU_BUILD=current
FROM nvidia/cuda:12.8.1-base-ubuntu22.04 AS base-current
FROM nvidia/cuda:12.6.3-base-ubuntu22.04 AS base-legacy
FROM base-${GPU_BUILD}

ARG GPU_BUILD
# PyTorch's CUDA 12.6 build, the newest that still includes Pascal. Its sm_60
# kernels also run on sm_61 cards such as the GTX 1050 Ti.
ARG LEGACY_TORCH_INDEX=https://download.pytorch.org/whl/cu126

WORKDIR /app

# yt-dlp runs deno for YouTube. A fixed version, checked against its
# published checksum. To update: change both, from the release's .sha256sum file.
ARG DENO_VERSION=2.9.8
ARG DENO_SHA256=e890975bc2549807bbcc0b584ffafda72cc7c93349dd99c80483dd784f6c4609

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-pip \
        ffmpeg \
        build-essential \
        postgresql-client \
        wget \
        unzip \
    && wget -qO /tmp/deno.zip "https://github.com/denoland/deno/releases/download/v${DENO_VERSION}/deno-x86_64-unknown-linux-gnu.zip" \
    && echo "${DENO_SHA256}  /tmp/deno.zip" | sha256sum -c - \
    && unzip -p /tmp/deno.zip deno > /usr/local/bin/deno \
    && chmod +x /usr/local/bin/deno \
    && rm -f /tmp/deno.zip \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.worker.txt .

# For legacy, torch and torchaudio come from PyTorch's index at the versions
# pinned in requirements.worker.txt; 2.14.1+cu126 satisfies torch==2.14.1.
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && if [ "$GPU_BUILD" = legacy ]; then \
        pip install --no-cache-dir --index-url "$LEGACY_TORCH_INDEX" \
            $(grep -E '^(torch|torchaudio)==' requirements.worker.txt) \
        && python3 -c "import torch; flags = torch._C._cuda_getArchFlags(); assert {'sm_60', 'sm_61'} & set(flags.split()), f'torch {torch.__version__} lacks Pascal GPUs: {flags}'"; \
    fi \
    && pip install --no-cache-dir -r requirements.worker.txt

# The worker runs untrusted media through yt-dlp and ffmpeg, so not as root.
# New volumes mounted at /data and /billing take the ownership below; see
# "Running as a non-root user" in docs/setup.md for older volumes.
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /data /billing \
    && chown app:app /data /billing

COPY app ./app

USER app

CMD ["python3", "-m", "app.worker.launcher"]
