# RunPod Serverless worker: Transkun inference only. Build and push:
#   docker build -f Dockerfile.runpod -t <registry>/piano-transcription-runpod:<version> .
# CUDA 12.8+ lets RunPod schedule the image on its newest GPUs too. The base
# image has no cuDNN or CUDA libraries: torch installs its own.
FROM nvidia/cuda:12.8.1-base-ubuntu22.04

WORKDIR /app

# A compiler and Python headers: ncls, a transkun dependency, has no wheel for
# this Python and is built from source.
# The build's own tools: apt's mirror lists, and fetch.py and pip_install.py,
# which take each download from the next source when one fails.
COPY build /build

RUN sh /build/apt-mirrors.sh \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-pip \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.runpod.txt .

# torch brings its own CUDA libraries, and RunPod picks hosts by the base
# image's CUDA version. Install torch for that version, from PyTorch's index
# for it (download.pytorch.org/whl/cu128) or a mirror, not the PyPI default
# (CUDA 13), or it fails on hosts whose driver supports only 12.8.
RUN python3 /build/pip_install.py --upgrade pip setuptools wheel \
    && python3 /build/pip_install.py --torch cu128 --no-cache-dir torch==2.11.0 torchaudio==2.11.0 \
    && python3 /build/pip_install.py --no-cache-dir -r requirements.runpod.txt

RUN python3 -c "import torch; assert torch.version.cuda.startswith('12.8'), f'torch is built for CUDA {torch.version.cuda}, need 12.8'"

# The model weights ship inside the transkun package, so they are part of the
# image. Fail the build if they are missing or unreadable.
RUN python3 -c "import pkg_resources, torch; torch.load(pkg_resources.resource_filename('transkun', 'pretrained/2.0.pt'), map_location='cpu')"

# Beat This! beat tracker weights for the MIDI tempo map
# (app/transcription/tempo.py), checked against their checksum and loaded once.
# From the authors' server (CPJKU, Austria), else a copy on Hugging Face at a
# fixed revision, else the Internet Archive's copy of the authors' file. Only
# a file with this checksum is kept, so a copy can be no other file.
ARG BEAT_THIS_CHECKPOINT_URL=https://cloud.cp.jku.at/public.php/dav/files/7ik4RrBKTS273gp/final0.ckpt
ARG BEAT_THIS_CHECKPOINT_MIRROR=https://huggingface.co/rtikw/localmusic-assets/resolve/a44f51ed621bc9895c15f8b46194cf16d7b22b66/analysis/beat_this-final0.ckpt
ARG BEAT_THIS_CHECKPOINT_ARCHIVE=https://web.archive.org/web/20250720021822id_/https://cloud.cp.jku.at/public.php/dav/files/7ik4RrBKTS273gp/final0.ckpt
ARG BEAT_THIS_CHECKPOINT_SHA256=8c328b45f59d8dd3dff219253ff6a8d6482be57d0133a29140e2febbf8eb8331
RUN mkdir -p /opt/beat-this \
    && python3 /build/fetch.py --sha256 "$BEAT_THIS_CHECKPOINT_SHA256" --out /opt/beat-this/final0.ckpt \
        "$BEAT_THIS_CHECKPOINT_URL" "$BEAT_THIS_CHECKPOINT_MIRROR" "$BEAT_THIS_CHECKPOINT_ARCHIVE" \
    && python3 -c "from beat_this.inference import load_model; load_model('/opt/beat-this/final0.ckpt')"

# AMT-APC weights for piano arrangements (app/transcription/arrangement.py),
# checked against their checksum, and loaded as plain tensors, never as code.
ARG AMT_APC_WEIGHTS_URL=https://github.com/310hz/amt-apc/releases/download/beta/apc.pth
ARG AMT_APC_WEIGHTS_SHA256=78ebe9a28d65ec3849132adef6c38de599692abed0ae00191753a5032554fe7b
RUN mkdir -p /opt/amt-apc \
    && python3 /build/fetch.py --sha256 "$AMT_APC_WEIGHTS_SHA256" --out /opt/amt-apc/apc.pth \
        "$AMT_APC_WEIGHTS_URL" \
    && python3 -c "import torch; torch.load('/opt/amt-apc/apc.pth', map_location='cpu', weights_only=True)"

COPY app ./app
COPY runpod/handler.py ./handler.py

ENV PYTHONUNBUFFERED=1

CMD ["python3", "-u", "handler.py"]
