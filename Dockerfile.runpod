# RunPod Serverless worker: Transkun inference only. Build and push:
#   docker build -f Dockerfile.runpod -t <registry>/piano-transcription-runpod:<version> .
# CUDA 12.8+ lets RunPod schedule the image on its newest GPUs too. The base
# image has no cuDNN or CUDA libraries: torch installs its own.
FROM nvidia/cuda:12.8.1-base-ubuntu22.04

WORKDIR /app

# A compiler and Python headers: ncls, a transkun dependency, has no wheel for
# this Python and is built from source.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-dev \
        python3-pip \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.runpod.txt .

# torch brings its own CUDA libraries, and RunPod picks hosts by the base
# image's CUDA version. Install torch for that version, not the PyPI default
# (CUDA 13), or it fails on hosts whose driver supports only 12.8.
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu128 torch==2.11.0 torchaudio==2.11.0 \
    && pip install --no-cache-dir -r requirements.runpod.txt

RUN python3 -c "import torch; assert torch.version.cuda.startswith('12.8'), f'torch is built for CUDA {torch.version.cuda}, need 12.8'"

# The model weights ship inside the transkun package, so they are part of the
# image. Fail the build if they are missing or unreadable.
RUN python3 -c "import pkg_resources, torch; torch.load(pkg_resources.resource_filename('transkun', 'pretrained/2.0.pt'), map_location='cpu')"

# Beat This! beat tracker weights for the MIDI tempo map
# (app/transcription/tempo.py), checked against their checksum and loaded once.
ARG BEAT_THIS_CHECKPOINT_URL=https://cloud.cp.jku.at/public.php/dav/files/7ik4RrBKTS273gp/final0.ckpt
ARG BEAT_THIS_CHECKPOINT_SHA256=8c328b45f59d8dd3dff219253ff6a8d6482be57d0133a29140e2febbf8eb8331
RUN mkdir -p /opt/beat-this \
    && python3 -c "import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], '/opt/beat-this/final0.ckpt')" "$BEAT_THIS_CHECKPOINT_URL" \
    && echo "${BEAT_THIS_CHECKPOINT_SHA256}  /opt/beat-this/final0.ckpt" | sha256sum -c - \
    && python3 -c "from beat_this.inference import load_model; load_model('/opt/beat-this/final0.ckpt')"

COPY app ./app
COPY runpod/handler.py ./handler.py

ENV PYTHONUNBUFFERED=1

CMD ["python3", "-u", "handler.py"]
